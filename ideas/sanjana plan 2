# --- 5. Virtual File System (VFS) ---

class VFSNode:
    def __init__(self, name, flags):
        self.name = name
        self.flags = flags
        self.read_callback = None
        self.write_callback = None

class VFS:
    @staticmethod
    def read(node, offset, size, buffer):
        if node and node.read_callback:
            return node.read_callback(node, offset, size, buffer)
        return 0

# --- 6. Task Scheduler & Context Switching ---

class Registers:
    def __init__(self, rip):
        self.rip = rip
        self.rax = 0
        self.rcx = 0

class Task:
    def __init__(self, task_id, rip):
        self.id = task_id
        self.regs = Registers(rip)
        self.next = None

class Scheduler:
    def __init__(self):
        self.current_task = None

    def init(self):
        self.task1 = Task(1, 0x401000) # Task A entry
        self.task2 = Task(2, 0x402000) # Task B entry
        
        self.task1.next = self.task2
        self.task2.next = self.task1
        
        self.current_task = self.task1
        print("[SCHED] Task scheduler initialized with 2 threads (Round-Robin).")

    def schedule(self):
        if not self.current_task:
            return
        self.current_task = self.current_task.next
        print(f"[SCHED] Context switched to Task ID: {self.current_task.id}")

# --- 7. Main Kernel Entry Point ---

def kmain():
    print("--- Booting ProductionKernel (Python Simulation) ---")
    
    # Mocking Stivale2 Bootloader Memory Map Tag
    mmap_entries = [
        Stivale2MMapEntry(base=0x100000, length=0x7FFFFFF000, type_=1)
    ]

    # Subsystems Initialization
    pmm = PMM()
    pmm.init(mmap_entries)

    slab = SlabAllocator()
    slab.init()

    gdt = GDTSubsystem()
    gdt.init()

    sched = Scheduler()
    sched.init()

    # Simulate running the multitasking loop for 3 ticks
    print("\n--- Entering Multitasking Loop ---")
    for tick in range(3):
        print(f"--- Tick {tick + 1} ---")
        sched.schedule()

if __name__ == "__main__":
    kmain()