{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["eslint:recommended", "plugin:react/recommended"],
  "settings": {
    "react": { "version": "detect" }
  },
  "ignorePatterns": ["dist", "node_modules", ".next"]
}
