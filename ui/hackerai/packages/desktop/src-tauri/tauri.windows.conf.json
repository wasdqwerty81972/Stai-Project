{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SVS Cyber",
  "version": "0.1.0",
  "identifier": "com.svscyber.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../protection-dashboard run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build-protection-dashboard.js",
    "frontendDist": "../../protection-dashboard/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SVS Cyber",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "userAgent": "STAI-Protection/1.0",
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost;",
      "capabilities": ["protection-local"]
    }
  }
}
