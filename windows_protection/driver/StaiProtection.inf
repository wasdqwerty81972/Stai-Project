; StaiProtection.inf - Installation file for STAI Minifilter Driver
; Test-signed package for VM-only development use

[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31d-4f78-ab85-0dcc84d6d3d8}
Provider    = %STAI_PROVIDER%
DriverVer   = 10/12/2026,1.0.0.0
CatalogFile = StaiProtection.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12
StaiProtection.DriverFiles = 12

[SourceDisksNames]
1 = %STAI_DISK_NAME%

[SourceDisksFiles]
StaiProtection.sys = 1

[DefaultInstall.NTamd64]
OptionDesc = %STAI_SERVICE_DESC%
CopyFiles  = StaiProtection.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = %STAI_SERVICE_NAME%,,StaiProtection.Service

[StaiProtection.DriverFiles]
StaiProtection.sys

[StaiProtection.Service]
DisplayName    = %STAI_SERVICE_NAME%
Description    = %STAI_SERVICE_DESC%
ServiceBinary  = %12%\StaiProtection.sys
Dependencies   = FltMgr
ServiceType    = 2
; Auto-load the minifilter at boot so file-operation coverage resumes after restart.
StartType      = 2
ErrorControl   = 1
LoadOrderGroup = "FSFilter Anti-Virus"
AddReg         = StaiProtection.AddReg

[StaiProtection.AddReg]
HKR,,"DebugFlags",0x00010001,0x0
HKR,"Instances","DefaultInstance",0x00000000,%STAI_INSTANCE_NAME%
HKR,"Instances\%STAI_INSTANCE_NAME%","Altitude",0x00000000,%STAI_ALTITUDE%
HKR,"Instances\%STAI_INSTANCE_NAME%","Flags",0x00010001,0x0

[Strings]
STAI_PROVIDER       = "STAI Project"
STAI_SERVICE_NAME   = "StaiProtection"
STAI_SERVICE_DESC   = "STAI File System Minifilter Protection Driver"
STAI_DISK_NAME      = "STAI Minifilter Installation Media"
STAI_INSTANCE_NAME  = "StaiProtection Instance"
; VM-only debug attachment value in the antivirus altitude range. Replace with an allocated altitude before release.
STAI_ALTITUDE       = "329999"
